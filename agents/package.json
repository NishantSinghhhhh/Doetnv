{
  "name": "stellar-ad-agent",
  "version": "1.0.0",
  "description": "Autonomous browser agent for placing ads with Stellar payments",
  "main": "index.js",
  "type": "commonjs",
  "scripts": {
    "agent": "node --loader ts-node/esm run-stellar-agent.ts || ts-node --esm run-stellar-agent.ts || npx ts-node run-stellar-agent.ts",
    "agent:keep-open": "KEEP_BROWSER_OPEN=true npx ts-node run-stellar-agent.ts",
    "agent:mainnet": "USE_MAINNET=true npx ts-node run-stellar-agent.ts",
    "build": "tsc",
    "dev": "ts-node-dev --respawn run-stellar-agent.ts"
  },
  "keywords": [
    "stellar",
    "puppeteer",
    "automation",
    "blockchain",
    "ai-agent"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "dotenv": "^16.3.1",
    "puppeteer": "^21.6.0",
    "stellar-sdk": "^11.3.0"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "ts-node": "^10.9.1",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.3.2"
  }
}